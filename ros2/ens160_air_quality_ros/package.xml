<?xml version="1.0"?>
<package format="3">
  <name>ens160_air_quality_ros</name>
  <version>0.1.0</version>
  <description>Read ENS160 measurements from USB serial and publish them in ROS 2.</description>
  <maintainer email="manel.puig@ub.edu">Manel Puig</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ens160_interfaces</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
